# 服务器上 .env 的模板：复制为 .env 后填写真实值（scripts/init-server.sh 会自动生成随机密钥）
# .env 里是密钥，不要提交到 Git、不要发给别人
# 注意：每行写成 名字=值，值里不要有空格和引号，注释单独写一行

# 数据库密码：只用字母和数字（会拼进数据库连接地址，特殊符号需要转义，容易出错）
# 生成方法：openssl rand -hex 24
DB_PASSWORD=

# 登录令牌签名密钥，64 位十六进制。生成方法：openssl rand -hex 32
JWT_SECRET=

# 微信号加密密钥，64 位十六进制。生成方法：openssl rand -hex 32
# 注意：上线后不要再改，否则已加密保存的微信号都解不开
WECHAT_AES_KEY=

# 登录令牌有效期（小时）
JWT_EXPIRE_HOURS=24

# AI 助手小航：DeepSeek 的 API Key（https://platform.deepseek.com）；留空则小航只用关键词搜索
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 全站每天最多调用大模型多少次，超过自动降级；0 表示不限制
ASSISTANT_GLOBAL_PER_DAY=300

# 每人每天最多发布几件物品
DAILY_PUBLISH_LIMIT=10

# 导入演示数据时，演示账号使用的密码（不要用公开的 Test1234）
SEED_PASSWORD=
